# Database Configuration
POSTGRES_DB=electric
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secure-password-here

# Domain Configuration
# Option 1: Free domain (replace 123.45.67.89 with your server IP)
APP_DOMAIN=123.45.67.89.nip.io
APP_URL=https://123.45.67.89.nip.io
ELECTRIC_DOMAIN=electric.123.45.67.89.nip.io

# Option 2: Custom domain (if you own one)
# APP_DOMAIN=yourdomain.com
# APP_URL=https://yourdomain.com
# ELECTRIC_DOMAIN=electric.yourdomain.com

# Electric Configuration
ELECTRIC_INSECURE=false
ELECTRIC_AUTH_MODE=secure

# Better Auth
BETTER_AUTH_SECRET=your-generated-secret-here-use-openssl-rand-base64-32

# Let's Encrypt / ACME
ACME_EMAIL=your-email@example.com
